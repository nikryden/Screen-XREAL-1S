<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="XrealScreen.App.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="24,16,24,24" Spacing="16" MaxWidth="1100">
        <TextBlock Style="{StaticResource PageTitleStyle}" Text="About" />
        <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="XrealScreen" />
                <TextBlock TextWrapping="Wrap" Text="Virtual multi-monitor workspace for XREAL glasses on Windows. Not affiliated with or endorsed by XREAL." />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="MIT License. Third-party components and protocol sources are listed in THIRD-PARTY-NOTICES.md." />
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
