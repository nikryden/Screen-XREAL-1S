<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="XrealScreen.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" Spacing="16" MaxWidth="1100">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Settings" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Background" />
                    <ToggleSwitch
                        x:Name="StartWithWindowsToggle"
                        Header="Start XrealScreen when you sign in to Windows (starts in the tray)"
                        Toggled="StartWithWindows_Toggled" />
                    <TextBlock
                        x:Name="StartupHint"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <ToggleSwitch
                        x:Name="TrayToggle"
                        Header="Keep running in the tray when the window is closed"
                        Toggled="Tray_Toggled" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="Tray icon: left-click opens XrealScreen, right-click for Start / Stop / Recenter / Exit. Ctrl+Alt+W starts or stops the workspace from anywhere." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <RadioButtons x:Name="ThemeRadio" Header="App theme" SelectionChanged="ThemeRadio_SelectionChanged">
                    <x:String>Use system setting</x:String>
                    <x:String>Light</x:String>
                    <x:String>Dark</x:String>
                </RadioButtons>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
